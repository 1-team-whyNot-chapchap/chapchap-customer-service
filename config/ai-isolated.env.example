# Deliberate opt-in for isolated verification only, NOT a production activation manifest.
# Merge into process environment after preparing trusted HTTPS endpoints and actual secrets.
SPRING_PROFILES_ACTIVE=ai-isolated
CUSTOMER_AI_ACTIVATION_MODE=ISOLATED
CUSTOMER_AI_INTERNAL_AUTH_ENABLED=true
CUSTOMER_AI_CALLBACK_AUTH_ENABLED=true
CUSTOMER_AI_KNOWLEDGE_ASYNC_ENABLED=true
CUSTOMER_AI_CONSULTATION_RESPONSE_ASYNC_ENABLED=true
CUSTOMER_AI_CONSULTATION_SUMMARY_ASYNC_ENABLED=true
CUSTOMER_AI_OBSERVABILITY_ENABLED=true
# Fill all origins with trusted HTTPS services. These placeholders do not supply live endpoints.
AUTH_SERVICE_BASE_URL=
AUTH_SERVICE_JWKS_URL=
CUSTOMER_AI_BASE_URL=
# Read secrets from secret storage / ignored .env; never commit actual values.
AUTH_CUSTOMER_SERVICE_CLIENT_SECRET=
CUSTOMER_AI_SUBJECT_PRIVATE_KEY_PEM=
CUSTOMER_AI_SUBJECT_PUBLIC_KEY_PEM=
CUSTOMER_AI_SUBJECT_KEY_ID=customer-subject-1
