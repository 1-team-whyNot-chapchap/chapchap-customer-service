# Customer-Service 로컬/Postman 예시. 실제 자격정보는 .env에만 입력하세요.
# 저장소 루트에서 .env로 복사하면 Spring이 Java properties 형식으로 읽습니다.
# KEY=value 형식이며 export/값 주변 따옴표를 쓰지 않습니다. OS 환경변수가 우선합니다.
# 아래 change-me 값은 실제 비밀값이 아니며 본인 로컬 환경에 맞게 바꿔야 합니다.

# HTTP / multipart: 파일당 10MB 고정, 요청 전체는 multipart 메타데이터 포함 11MB.
# 여러 첨부파일은 전체 합계도 요청 한도 안이어야 합니다.
APP_PORT=8084
CUSTOMER_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
MULTIPART_MAX_REQUEST_SIZE=11MB

# MySQL: 기본은 DB만 실행, --profile app을 추가하면 앱도 실행합니다. 테이블은 별도 준비합니다.
# ddl-auto=validate 유지. DB_PASSWORD와 MYSQL_PASSWORD는 같은 값으로 맞추세요.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=customer_db
DB_USER=chapchap
DB_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root-password

# Kafka: REST 단독 확인용 예시는 수신을 끕니다. 이벤트 검증 시 true + 실제 broker 필요.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LISTENER_AUTO_STARTUP=false

# MinIO: 두 저장소 client 생성에 필요합니다. 실제 계정과 private bucket을 준비하세요.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_KNOWLEDGE_BUCKET=customer-knowledge
MINIO_QUALITY_INQUIRY_BUCKET=customer-quality
MINIO_KNOWLEDGE_PRESIGNED_GET_URL_EXPIRY_SECONDS=300

# 지식 자동 활성화: REST 단독 확인용 예시는 끕니다.
KNOWLEDGE_ACTIVATION_SCHEDULER_ENABLED=false
KNOWLEDGE_ACTIVATION_SCHEDULER_FIXED_DELAY=60000

# AI는 기본 비활성. 아래 false들을 임의로 true로 바꾸면 시작 gate가 거절합니다.
# 격리 연동: ACTIVATION_MODE=ISOLATED + SPRING_PROFILES_ACTIVE=ai-isolated,
# 필요한 내부 인증/콜백/비동기 플래그, HTTPS 주소, Auth 계정과 RSA 키를 함께 준비합니다.
# ACTIVE는 운영 증거 manifest가 미완료인 동안 사용할 수 없습니다.
CUSTOMER_AI_ACTIVATION_MODE=DISABLED
CUSTOMER_AI_OBSERVABILITY_ENABLED=true
CUSTOMER_AI_INTERNAL_AUTH_ENABLED=false
CUSTOMER_AI_CALLBACK_AUTH_ENABLED=false
CUSTOMER_AI_KNOWLEDGE_ASYNC_ENABLED=false
CUSTOMER_AI_CONSULTATION_RESPONSE_ASYNC_ENABLED=false
CUSTOMER_AI_CONSULTATION_SUMMARY_ASYNC_ENABLED=false

# 비활성 기본 주소입니다. AI 기능을 켜기 전에 실제 HTTPS origin으로 바꾸세요.
# HTTPS origin = 경로/쿼리 없는 https://호스트[:포트]
CUSTOMER_AI_BASE_URL=http://localhost:8085
CUSTOMER_AI_CONNECT_TIMEOUT_MILLISECONDS=1000
CUSTOMER_AI_READ_TIMEOUT_MILLISECONDS=10000

# Customer -> Auth 토큰 발급. Auth에 등록한 Customer client secret을 입력합니다.
AUTH_SERVICE_BASE_URL=https://auth-service
AUTH_SERVICE_TOKEN_PATH=/internal/v1/service-tokens
AUTH_CUSTOMER_SERVICE_CLIENT_ID=customer-service
AUTH_CUSTOMER_SERVICE_CLIENT_SECRET=
AUTH_CUSTOMER_SERVICE_AUDIENCE=chapchap-customer-ai
AUTH_CUSTOMER_SERVICE_SCOPE=customer-ai.invoke
AUTH_SERVICE_CONNECT_TIMEOUT_MILLISECONDS=1000
AUTH_SERVICE_READ_TIMEOUT_MILLISECONDS=3000

# Customer -> AI Subject Assertion RSA 키. 예시에 실제 키를 넣지 않습니다.
# .env에서 PEM 줄바꿈은 한 줄의 \n으로 표현할 수 있습니다. 자세한 내용은 README 참고.
CUSTOMER_AI_SUBJECT_KEY_ID=customer-subject-1
CUSTOMER_AI_SUBJECT_PRIVATE_KEY_PEM=
CUSTOMER_AI_SUBJECT_PUBLIC_KEY_PEM=
CUSTOMER_AI_SUBJECT_LIFETIME_SECONDS=60

# AI -> Customer 콜백 JWT 검증. issuer/audience/subject/scope는 확정 계약값입니다.
AUTH_SERVICE_JWKS_URL=https://auth-service/.well-known/jwks.json
CUSTOMER_AI_CALLBACK_ISSUER=chapchap-auth-service
CUSTOMER_AI_CALLBACK_AUDIENCE=chapchap-customer-service
CUSTOMER_AI_CALLBACK_SUBJECT=customer-ai
CUSTOMER_AI_CALLBACK_SCOPE=customer-ai.callback
CUSTOMER_AI_CALLBACK_MAXIMUM_LIFETIME_SECONDS=300
AUTH_SERVICE_JWKS_CACHE_SECONDS=300
AUTH_SERVICE_JWKS_CONNECT_TIMEOUT_MILLISECONDS=1000
AUTH_SERVICE_JWKS_READ_TIMEOUT_MILLISECONDS=3000

# 구조화 로그. Prometheus 설정은 없습니다.
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash

# Docker에서 접근 가능한 외부 인프라 주소. localhost는 컨테이너 자신을 뜻합니다.
COMPOSE_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
COMPOSE_MINIO_ENDPOINT=http://host.docker.internal:9000

# Direct internal Auth endpoint for current account checks
AUTH_SERVICE_URI=http://localhost:8081

# Customer container -> Auth running on the host (override for a shared container network)
COMPOSE_AUTH_SERVICE_URI=http://host.docker.internal:8081
